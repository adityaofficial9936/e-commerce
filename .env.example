# Application
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# Auth & JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
STRIPE_SECRET_KEY=

# Storage (MinIO local / S3 or Cloudinary)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ecommerce-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CLOUDINARY_URL=

# Search (Meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey1234567890

# Mail (Mailpit for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Store Support <no-reply@store.local>"
SMS_API_KEY=

# AI Chatbot Assistant
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Public Frontend Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
